@page
@model ContosoUniversity.Pages.Departments.DeleteModel

@{
    ViewData["Title"] = "Delete";
}

<h2>Delete</h2>

@if (!string.IsNullOrEmpty(Model.ConcurrencyError))
{
    <p class="text-danger">@Model.ConcurrencyError</p>
}

<h3>Are you sure you want to delete this?</h3>

<div>
    <h4>Department</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Department.Name)</dt>
        <dd class="col-sm-10">
            @if (Model.Department != null)
            {
                @Html.DisplayFor(model => model.Department.Name)
            }
            else
            {
                <span class="text-muted">No department data</span>
            }
        </dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Department.Budget)</dt>
        <dd class="col-sm-10">
            @if (Model.Department != null)
            {
                @Html.DisplayFor(model => model.Department.Budget)
            }
            else
            {
                <span class="text-muted">No budget data</span>
            }
        </dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Department.StartDate)</dt>
        <dd class="col-sm-10">
            @if (Model.Department != null)
            {
                @Html.DisplayFor(model => model.Department.StartDate)
            }
            else
            {
                <span class="text-muted">No start date</span>
            }
        </dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Department.Administrator)</dt>
        <dd class="col-sm-10">
            @if (Model.Department?.Administrator != null)
            {
                @Html.DisplayFor(model => model.Department.Administrator.FullName)
            }
            else
            {
                <span class="text-muted">No administrator assigned</span>
            }
        </dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Department.DepartmentID" />
        <input type="hidden" asp-for="Department.RowVersion" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="./Index" class="btn btn-secondary ms-2">Back to List</a>
    </form>
</div>

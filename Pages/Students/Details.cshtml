@page "{id:int}"
@model ContosoUniversity.Pages.Students.DetailsModel

@{
    ViewData["Title"] = "Details";
}

<h1>Student Details</h1>

<div>
    <h4>Student Info</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Last Name</dt>
        <dd class="col-sm-10">@Model.Student.LastName</dd>

        <dt class="col-sm-2">First Name</dt>
        <dd class="col-sm-10">@Model.Student.FirstMidName</dd>

        <dt class="col-sm-2">Enrollment Date</dt>
        <dd class="col-sm-10">@Model.Student.EnrollmentDate.ToShortDateString()</dd>
    </dl>
</div>

<div>
    <h4>Enrollments</h4>
    @if (Model.Student.Enrollments.Any())
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Course</th>
                    <th>Credits</th>
                    <th>Grade</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model.Student.Enrollments)
                {
                    <tr>
                        <td>@e.Course.Title</td>
                        <td>@e.Course.Credits</td>
                        <td>@e.Grade?.ToString() ?? "N/A"</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>No enrollments found.</p>
    }
</div>

<div>
    <a asp-page="./Edit" asp-route-id="@Model.Student.ID" class="btn btn-primary">Edit</a>
    <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
</div>

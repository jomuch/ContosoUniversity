@page
@model ContosoUniversity.Pages.Students.DeleteModel

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Student</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Student!.LastName)</dt>
        <dd class="col-sm-10">
            @if (Model.Student != null)
            {
                @Html.DisplayFor(model => model.Student.LastName)
            }
            else
            {
                <span class="text-muted">No student data</span>
            }
        </dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Student!.FirstMidName)</dt>
        <dd class="col-sm-10">
            @if (Model.Student != null)
            {
                @Html.DisplayFor(model => model.Student.FirstMidName)
            }
            else
            {
                <span class="text-muted">No student data</span>
            }
        </dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Student!.EnrollmentDate)</dt>
        <dd class="col-sm-10">
            @if (Model.Student != null)
            {
                @Html.DisplayFor(model => model.Student.EnrollmentDate)
            }
            else
            {
                <span class="text-muted">No enrollment date</span>
            }
        </dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Student.ID" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-page="./Index">Back to List</a>
    </form>
</div>
